# Copy this file to .env.local and fill in the values.
#
# .env.local is git-ignored and never leaves your machine. The same values go
# into the Vercel project under Settings → Environment Variables; the site will
# not build without them. See HANDOVER.md.
#
# Note: with a src/ directory, Next reads .env files from the project root
# only — this directory, next to package.json. Not from inside src/.

# ---------------------------------------------------------------------------
# Sanity — where the content lives
# ---------------------------------------------------------------------------
# Both of these are public: they appear in image addresses and in the browser
# bundle. That is expected and safe.
#
# Find them at https://sanity.io/manage → the project → Settings.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ---------------------------------------------------------------------------
# Draft preview — reading unpublished work
# ---------------------------------------------------------------------------
# A Viewer token, created at sanity.io/manage → the project → API → Tokens.
# Give it Viewer permission, not Editor: it only ever needs to read.
#
# This one IS a secret. Anyone holding it can read unpublished drafts.
SANITY_API_READ_TOKEN=

# A password of your own invention, any random string, used to stop strangers
# opening preview links. The same value goes in the Studio's preview URL.
SANITY_DRAFT_SECRET=

# ---------------------------------------------------------------------------
# Publishing — putting new content on the site the moment it is published
# ---------------------------------------------------------------------------
# Another password of your own invention. The same value goes in the Sanity
# webhook's "Secret" field (sanity.io/manage → API → Webhooks); the site
# ignores any webhook call not signed with it. See HANDOVER.md → Publishing
# pipeline. Without it, new content still appears, but only after up to
# fifteen minutes.
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Readership — what decides Top stories on the front page
# ---------------------------------------------------------------------------
# An EDITOR token (sanity.io/manage → API → Tokens), because the site writes
# read and share counts back to Sanity. A secret: it can change content.
# Without it nothing is counted and Top stories simply follow recency.
#
# Counting only happens on the production deployment. Set
# TRACK_READERSHIP=1 to count from anywhere else, e.g. to test locally —
# but those counts go into the same dataset as the live site's.
SANITY_API_WRITE_TOKEN=
